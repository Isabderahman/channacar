# Copy to .env and fill in. Used by docker-compose and the deploy scripts.

# ---- Laravel ----
# Leave APP_KEY empty; ./deploy.sh generates it on first run (or run:
#   docker compose run --rm backend php artisan key:generate --show)
APP_KEY=
ADMIN_USER_EMAIL=admin@channacar.com
ADMIN_USER_PASSWORD=ChangeMe123!

# ---- MySQL ----
MYSQL_DATABASE=channacar
MYSQL_USER=channacar
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# ---- Mail (SMTP via Brevo) ----
# Brevo (brevo.com) transactional SMTP. The sender (MAIL_FROM_ADDRESS) must be a
# verified sender in Brevo, and the sending server's public IP must be added under
# Brevo → Security → Authorized IPs. MAIL_USERNAME/PASSWORD come from Brevo → SMTP & API.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=echanaacar@gmail.com
MAIL_FROM_NAME=ChannaCar

# ---- Meta (Facebook) Pixel ----
# Pixel ID: Events Manager → Data sources → your pixel (the number under its name).
# Used by both the browser pixel (frontend) and the Conversions API (backend).
META_PIXEL_ID=
# Events Manager → your pixel → Settings → Conversions API → Generate access token.
# Secret: keep it only in this server .env, never in git.
META_CAPI_ACCESS_TOKEN=
# Optional, for verifying: Events Manager → Test events code (e.g. TEST12345).
# Server events then show in the Test events tab. Clear it once verified.
META_TEST_EVENT_CODE=

# ---- Let's Encrypt ----
CERTBOT_EMAIL=admin@chanaacar.com
# Set to 1 while testing to avoid Let's Encrypt rate limits (staging certs).
CERTBOT_STAGING=0
